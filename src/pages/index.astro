---
import MetaPage from "@/components/MetaPage.astro"
import PostList from "@/components/PostList.astro"
import Layout from "@/layouts/Layout.astro"
import { CATEGORY_SLUGS } from "@/categories"
import { SITE } from "@/consts"
import { getFeaturedPosts, getPostList } from "@/lib/posts"
import { formatDate } from "@/lib/utils"

const featured = await getFeaturedPosts()
const latest = (await getPostList())
  .filter((post) => post.category !== "CV")
  .slice(0, 5)
---

<Layout>
  <MetaPage slot="head" />
  <prose-content>
    <h1>{SITE.title}</h1>
    <p>{SITE.description}</p>
    <p>
      <em
        >I write to feed my own curiosity &mdash; an article is a success if
        I learned something from writing it.</em
      >
    </p>
  </prose-content>

  <section>
    <h2>Start here</h2>
    <PostList posts={featured} />
  </section>

  <section>
    <h2>Latest</h2>
    <ul class="latest-list">
      {
        latest.map((post) => (
          <li data-category={CATEGORY_SLUGS[post.category]}>
            <a href={post.href}>{post.title}</a>
            <span class="meta">
              {post.category} &middot; {formatDate(post.created)}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  section {
    margin-block-start: var(--space-xl);
  }

  /* Headings are reset outside `prose-content`, so they're styled locally. */
  h2 {
    font-family: var(--font-sans);
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
    line-height: calc(var(--leading-offset) + 1em);
    color: var(--foreground);
  }

  .latest-list {
    list-style: none;
    padding-inline-start: 0;
    margin-block-start: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .latest-list li[data-category="thinkoneering"] a {
    --link: var(--link-thinkoneering);
  }
  .latest-list li[data-category="publications"] a {
    --link: var(--link-publications);
  }

  .latest-list a {
    color: var(--link);
    text-decoration-color: transparent;
    text-decoration-thickness: max(1px, 0.0625em);
  }

  .latest-list a:hover {
    text-decoration-color: currentColor;
  }

  .latest-list .meta {
    color: var(--muted-foreground);
    font-size: var(--step--1);
    margin-inline-start: var(--space-2xs);
  }
</style>
