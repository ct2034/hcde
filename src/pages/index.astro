---
import { Image } from "astro:assets"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { CATEGORY_SLUGS } from "@/categories"
import { SITE } from "@/consts"
import { getFeaturedPosts, getPostList } from "@/lib/posts"
import { formatDate } from "@/lib/utils"

const featured = await getFeaturedPosts()
const latest = (await getPostList())
  .filter((post) => post.category !== "CV")
  .slice(0, 5)
---

<Layout>
  <MetaPage slot="head" />
  <header class="hero">
    <prose-content>
      <h1>{SITE.title}</h1>
      <p>{SITE.description}</p>
      <p>
        <em
          >I write to feed my own curiosity &mdash; an article is a success
          if I learned something from writing it.</em
        >
      </p>
    </prose-content>
    <nav class="hero-links" aria-label="Sections">
      <a href="/thinkoneering/">Blog</a>
      <a href="/publications/">Research</a>
      <a href="/cv/">CV</a>
    </nav>
  </header>

  <section>
    <h2>Start here</h2>
    <div class="featured-grid">
      {
        featured.map((post) => (
          <article data-category={CATEGORY_SLUGS[post.category]}>
            {post.thumbnail && (
              <a href={post.href} tabindex="-1" aria-hidden="true">
                <Image src={post.thumbnail} alt="" width={480} densities={[1, 2]} />
              </a>
            )}
            <h3>
              <a href={post.href}>{post.title}</a>
            </h3>
            <time datetime={post.created.toISOString()}>
              {formatDate(post.created)}
            </time>
            {post.excerpt && <prose-content set:html={post.excerpt} />}
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Latest</h2>
    <ul class="latest-list">
      {
        latest.map((post) => (
          <li data-category={CATEGORY_SLUGS[post.category]}>
            <a href={post.href}>{post.title}</a>
            <span class="meta">
              {post.category} &middot; {formatDate(post.created)}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  section {
    margin-block-start: var(--space-xl);
  }

  /* Headings are reset outside `prose-content`, so they're styled locally. */
  h2 {
    font-family: var(--font-sans);
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
    line-height: calc(var(--leading-offset) + 1em);
    color: var(--foreground);
  }

  /* Intro and quick links side by side on wider screens, stacked below. */
  .hero {
    display: grid;
    gap: var(--space-m);
    align-items: start;

    @media (width >= 40rem) {
      grid-template-columns: 1fr auto;
      gap: var(--space-l);
    }
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: var(--space-2xs);
  }

  .hero-links a {
    display: inline-block;
    padding-block: var(--space-3xs);
    padding-inline: var(--space-s);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--foreground);
    text-decoration-color: transparent;
    white-space: nowrap;
  }

  .hero-links a:hover {
    border-color: var(--foreground);
    text-decoration-color: currentColor;
  }

  /* Two cards per row on wider screens, one per row on mobile. */
  .featured-grid {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-m);

    @media (width >= 40rem) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .featured-grid article {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-s);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .featured-grid article[data-category="thinkoneering"] h3 a {
    --link: var(--link-thinkoneering);
  }
  .featured-grid article[data-category="publications"] h3 a {
    --link: var(--link-publications);
  }
  .featured-grid article[data-category="cv"] h3 a {
    --link: var(--link-cv);
  }

  .featured-grid :global(img) {
    inline-size: 100%;
    block-size: auto;
    max-block-size: 10rem;
    object-fit: contain;
    padding: var(--space-3xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .featured-grid h3 {
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    line-height: calc(var(--leading-offset) + 1em);
  }

  .featured-grid h3 a {
    color: var(--link);
    text-decoration-color: transparent;
  }

  .featured-grid h3 a:hover {
    text-decoration-color: currentColor;
  }

  .featured-grid time {
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  /* Title and category/date side by side per row, stacked on mobile. */
  .latest-list {
    list-style: none;
    padding-inline-start: 0;
    margin-block-start: var(--space-m);
    display: flex;
    flex-direction: column;
  }

  .latest-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-m);
    padding-block: var(--space-2xs);
    border-block-end: 1px solid var(--border);

    @media (width < 40rem) {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3xs);
    }
  }

  .latest-list li[data-category="thinkoneering"] a {
    --link: var(--link-thinkoneering);
  }
  .latest-list li[data-category="publications"] a {
    --link: var(--link-publications);
  }

  .latest-list a {
    color: var(--link);
    text-decoration-color: transparent;
    text-decoration-thickness: max(1px, 0.0625em);
  }

  .latest-list a:hover {
    text-decoration-color: currentColor;
  }

  .latest-list .meta {
    color: var(--muted-foreground);
    font-size: var(--step--1);
    white-space: nowrap;
  }
</style>
